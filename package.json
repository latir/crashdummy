{
  "name": "crashdummy-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": "github:latir/crashdummy",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "oxlint && prettier --check .",
    "format": "prettier --write .",
    "check:deps": "node scripts/check-prod-deps.mjs",
    "corpus:update": "node corpus/tools/measure.mjs",
    "corpus:check": "node corpus/tools/measure.mjs --check",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^20.19.0",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.0",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "@types/node": "20"
      }
    }
  }
}
